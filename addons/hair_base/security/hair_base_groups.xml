<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_base_category" model="ir.module.category">
        <field name="name">Hair Purchasing</field>
    </record>
    <record id="hair_base_privilege" model="res.groups.privilege">
        <field name="name">Hair Master Data</field>
        <field name="category_id" ref="hair_base_category"/>
    </record>
    <record id="hair_base_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="hair_base_privilege"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="hair_base_group_manager" model="res.groups">
        <field name="name">Configuration Administrator</field>
        <field name="privilege_id" ref="hair_base_privilege"/>
        <field name="implied_ids" eval="[Command.link(ref('hair_base_group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('hair_base_group_manager'))]"/>
    </record>
</odoo>
