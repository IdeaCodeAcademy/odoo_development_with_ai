<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_length_view_list" model="ir.ui.view">
        <field name="name">hair.length.view.list</field>
        <field name="model">hair.length</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="length_min"/>
                <field name="length_max" invisible="open_ended"/>
                <field name="open_ended"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="hair_length_view_form" model="ir.ui.view">
        <field name="name">hair.length.view.form</field>
        <field name="model">hair.length</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                <field name="length_min"/>
                <field name="length_max" invisible="open_ended"/>
                <field name="open_ended"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hair_length_view_search" model="ir.ui.view">
        <field name="name">hair.length.view.search</field>
        <field name="model">hair.length</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="hair_length_action" model="ir.actions.act_window">
        <field name="name">Hair Lengths</field>
        <field name="res_model">hair.length</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
