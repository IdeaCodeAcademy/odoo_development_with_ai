<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_inventory_privilege" model="res.groups.privilege"><field name="name">Hair Inventory</field><field name="category_id" ref="hair_base.hair_base_category"/></record>
    <record id="group_hair_warehouse" model="res.groups"><field name="name">Warehouse User</field><field name="privilege_id" ref="hair_inventory_privilege"/><field name="implied_ids" eval="[Command.link(ref('hair_base.hair_base_group_user')), Command.link(ref('stock.group_stock_user'))]"/></record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[Command.link(ref('group_hair_warehouse'))]"/></record>
    <record id="receipt_company" model="ir.access"><field name="name">Hair receipt company</field><field name="model_id" ref="model_hair_receipt"/><field name="operation">crud</field><field name="domain">[('company_id', 'in', company_ids)]</field></record>
    <record id="receipt_line_company" model="ir.access"><field name="name">Hair receipt line company</field><field name="model_id" ref="model_hair_receipt_line"/><field name="operation">crud</field><field name="domain">[('company_id', 'in', company_ids)]</field></record>
</odoo>
