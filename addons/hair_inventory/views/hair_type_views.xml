<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_type_inventory_form" model="ir.ui.view">
        <field name="name">hair.type.inventory.form</field><field name="model">hair.type</field>
        <field name="inherit_id" ref="hair_base.hair_type_view_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='active']" position="after"><field name="stock_product_id" domain="[('is_storable', '=', True), ('tracking', '=', 'lot')]"/></xpath></field>
    </record>
</odoo>
