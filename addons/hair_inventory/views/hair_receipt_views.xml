<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_receipt_list" model="ir.ui.view"><field name="name">hair.receipt.list</field><field name="model">hair.receipt</field><field name="arch" type="xml"><list><field name="purchase_id"/><field name="picking_type_id"/><field name="picking_id"/><field name="received_date"/><field name="state"/></list></field></record>
    <record id="hair_receipt_form" model="ir.ui.view"><field name="name">hair.receipt.form</field><field name="model">hair.receipt</field><field name="arch" type="xml"><form><header><button name="action_receive" type="object" string="Receive Hair" class="btn-primary" groups="hair_inventory.group_hair_warehouse" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="purchase_id" domain="[('state', '=', 'paid')]" readonly="state != 'draft'"/><field name="company_id"/><field name="picking_type_id" domain="[('code', '=', 'incoming'), ('company_id', '=', company_id)]" readonly="state != 'draft'"/><field name="picking_id"/><field name="received_by_id"/><field name="received_date"/></group><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="purchase_line_id" domain="[('purchase_id', '=', parent.purchase_id)]"/><field name="purchased_weight"/><field name="cumulative_received_weight"/><field name="quantity"/></list></field></sheet></form></field></record>
    <record id="hair_receipt_action" model="ir.actions.act_window"><field name="name">Hair Receipts</field><field name="res_model">hair.receipt</field><field name="view_mode">list,form</field></record>
    <menuitem id="hair_receipt_menu" name="Hair Receipts" parent="hair_base.hair_base_menu_root" action="hair_receipt_action" groups="hair_inventory.group_hair_warehouse" sequence="8"/>
    <record id="hair_lot_traceability_form" model="ir.ui.view"><field name="name">stock.lot.hair.traceability</field><field name="model">stock.lot</field><field name="inherit_id" ref="stock.view_production_lot_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Hair Source" groups="hair_inventory.group_hair_warehouse" invisible="not hair_receipt_line_id"><field name="hair_receipt_line_id"/><field name="hair_purchase_id"/><field name="hair_seller_snapshot"/><field name="hair_purchase_date"/><field name="hair_type_snapshot"/><field name="hair_grade_snapshot"/><field name="hair_length_snapshot"/><field name="hair_original_weight"/></group></xpath></field></record>
</odoo>
