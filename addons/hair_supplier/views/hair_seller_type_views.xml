<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_seller_type_view_list" model="ir.ui.view">
        <field name="name">hair.seller.type.view.list</field>
        <field name="model">hair.seller.type</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list>
        </field>
    </record>
    <record id="hair_seller_type_view_form" model="ir.ui.view">
        <field name="name">hair.seller.type.view.form</field>
        <field name="model">hair.seller.type</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="sequence"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></sheet></form>
        </field>
    </record>
    <record id="hair_seller_type_action" model="ir.actions.act_window">
        <field name="name">Seller Types</field>
        <field name="res_model">hair.seller.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="hair_seller_type_menu" name="Seller Types" parent="hair_base.hair_base_menu_configuration" action="hair_seller_type_action" sequence="20"/>
</odoo>
