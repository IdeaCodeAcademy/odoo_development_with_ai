<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_seller_type_rule_company" model="ir.access">
        <field name="name">hair.seller.type.rule.company</field>
        <field name="model_id" ref="model_hair_seller_type"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="res_partner_access_hair_buyer" model="ir.access">
        <field name="name">Hair buyers create and update company sellers</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_id" ref="hair_supplier_group_buyer"/>
        <field name="operation">cru</field>
        <field name="domain">[('hair_is_seller', '=', True), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="res_partner_rule_hair_seller_company" model="ir.access">
        <field name="name">Hair seller company isolation</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="operation">crud</field>
        <field name="domain">['|', ('hair_is_seller', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
