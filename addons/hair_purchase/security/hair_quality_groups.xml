        <field name="category_id" ref="hair_base.hair_base_category"/>
    </record>
    <record id="hair_purchase_group_quality" model="res.groups">
        <field name="name">Quality Officer</field>
        <field name="privilege_id" ref="hair_quality_privilege"/>
