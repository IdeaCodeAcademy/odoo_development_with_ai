<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_purchase_company" model="ir.access">
        <field name="name">Hair purchase company restriction</field>
        <field name="model_id" ref="model_hair_purchase"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="hair_purchase_line_company" model="ir.access">
        <field name="name">Hair purchase line company restriction</field>
        <field name="model_id" ref="model_hair_purchase_line"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
