<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_payment_method_list" model="ir.ui.view"><field name="name">hair.payment.method.list</field><field name="model">hair.payment.method</field><field name="arch" type="xml"><list editable="bottom" delete="0"><field name="sequence" widget="handle"/><field name="name"/><field name="company_id"/><field name="active"/></list></field></record>
    <record id="hair_payment_method_action" model="ir.actions.act_window"><field name="name">Payment Methods</field><field name="res_model">hair.payment.method</field><field name="view_mode">list,form</field></record>
    <menuitem id="hair_payment_method_menu" name="Payment Methods" parent="hair_base.hair_base_menu_root" action="hair_payment_method_action" groups="hair_base.hair_base_group_manager" sequence="70"/>
    <record id="hair_payment_list" model="ir.ui.view"><field name="name">hair.purchase.payment.list</field><field name="model">hair.purchase.payment</field><field name="arch" type="xml"><list><field name="purchase_id"/><field name="seller_id"/><field name="date"/><field name="method_id"/><field name="currency_id"/><field name="amount"/><field name="reference"/><field name="state"/></list></field></record>
    <record id="hair_payment_form" model="ir.ui.view"><field name="name">hair.purchase.payment.form</field><field name="model">hair.purchase.payment</field><field name="arch" type="xml"><form><header><button name="action_post" type="object" string="Post Payment Record" class="btn-primary" groups="hair_purchase.hair_purchase_group_cashier" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="purchase_id" domain="[('state', '=', 'confirmed')]" readonly="state != 'draft'"/><field name="company_id"/><field name="seller_id"/><field name="currency_id"/><field name="amount" readonly="state != 'draft'"/><field name="date" readonly="state != 'draft'"/><field name="method_id" domain="[('company_id', '=', company_id)]" readonly="state != 'draft'"/><field name="reference" readonly="state != 'draft'"/><field name="notes" readonly="state != 'draft'"/><field name="posted_by_id"/><field name="posted_date"/></group></sheet></form></field></record>
    <record id="hair_payment_action" model="ir.actions.act_window"><field name="name">Payment Records</field><field name="res_model">hair.purchase.payment</field><field name="view_mode">list,form</field></record>
    <menuitem id="hair_payment_menu" name="Payment Records" parent="hair_base.hair_base_menu_root" action="hair_payment_action" groups="hair_supplier.hair_supplier_group_buyer,hair_purchase.hair_purchase_group_cashier" sequence="6"/>
    <record id="hair_purchase_payment_form" model="ir.ui.view"><field name="name">hair.purchase.payment.form.extension</field><field name="model">hair.purchase</field><field name="inherit_id" ref="hair_purchase_view_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Payments" name="payments"><group><field name="paid_amount"/><field name="balance_amount"/><field name="payment_status"/></group><field name="payment_ids" readonly="1" groups="hair_supplier.hair_supplier_group_buyer,hair_purchase.hair_purchase_group_cashier"><list><field name="date"/><field name="method_id"/><field name="currency_id"/><field name="amount"/><field name="reference"/><field name="state"/><field name="posted_by_id"/><field name="posted_date"/></list></field></page></xpath></field></record>
    <record id="hair_payable_purchase_action" model="ir.actions.act_window"><field name="name">Payable Purchases</field><field name="res_model">hair.purchase</field><field name="view_mode">list,form</field><field name="domain">[('state', 'in', ['confirmed', 'paid'])]</field></record>
    <menuitem id="hair_payable_purchase_menu" name="Payable Purchases" parent="hair_base.hair_base_menu_root" action="hair_payable_purchase_action" groups="hair_purchase.hair_purchase_group_cashier" sequence="7"/>
</odoo>
