<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_purchase_view_list" model="ir.ui.view">
        <field name="name">hair.purchase.list</field><field name="model">hair.purchase</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="date"/><field name="seller_id"/><field name="buyer_id"/><field name="payable_weight"/><field name="company_id" groups="base.group_multi_company"/><field name="state"/></list>
        </field>
    </record>
    <record id="hair_purchase_view_form" model="ir.ui.view">
        <field name="name">hair.purchase.form</field><field name="model">hair.purchase</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_inspection" string="Submit for Inspection" type="object" groups="hair_supplier.hair_supplier_group_buyer" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve_quality" string="Approve Quality" type="object" groups="hair_purchase.hair_purchase_group_quality" invisible="state != 'inspection' or quality_approved" class="oe_highlight"/>
                    <button name="action_reject_quality" string="Reject" type="object" groups="hair_purchase.hair_purchase_group_quality" invisible="state != 'inspection' or quality_approved"/>
                    <button name="action_return_to_draft" string="Return to Draft" type="object" groups="hair_supplier.hair_supplier_group_buyer" invisible="state != 'inspection'"/>
                    <button name="action_quote_purchase" string="Compute Price" type="object" groups="hair_supplier.hair_supplier_group_manager" invisible="state != 'inspection' or not quality_approved"/>
                    <button name="action_confirm_purchase" string="Confirm Purchase" type="object" class="oe_highlight" groups="hair_supplier.hair_supplier_group_manager" invisible="state != 'inspection' or not quality_approved"/>
                    <button name="action_cancel_purchase" string="Cancel Purchase" type="object" groups="hair_supplier.hair_supplier_group_manager" invisible="state not in ('draft', 'inspection', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,inspection,confirmed"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group><group><field name="company_id" readonly="state != 'draft'"/><field name="seller_id" readonly="state != 'draft'"/><field name="buyer_id" readonly="state != 'draft'"/></group><group><field name="date" readonly="state != 'draft'"/><field name="currency_id"/><field name="payable_weight"/><field name="amount_total"/></group></group>
                    <notebook><page string="Hair and Weights" name="hair_weights">
                        <field name="line_ids" readonly="state != 'draft'"><list editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="sequence" widget="handle"/><field name="description"/>
                            <field name="hair_type_id"/><field name="texture_id" optional="hide"/><field name="color_id" optional="hide"/><field name="length_id"/>
                            <field name="gross_weight"/><field name="tare_weight"/><field name="waste_weight"/><field name="moisture_weight"/><field name="other_weight"/><field name="payable_weight"/><field name="grade_id"/>
                        </list></field>
                    </page><page string="Quality" name="quality"><group>
                        <field name="quality_approved"/>
                        <field name="revision_reason" groups="hair_supplier.hair_supplier_group_buyer" readonly="state != 'inspection'"/><field name="inspector_id"/><field name="inspection_date"/>
                        <field name="inspection_notes" groups="hair_purchase.hair_purchase_group_quality" readonly="state != 'inspection' or quality_approved"/><field name="inspection_notes" groups="!hair_purchase.hair_purchase_group_quality" readonly="1"/>
                        <field name="rejection_reason" groups="hair_purchase.hair_purchase_group_quality" readonly="state != 'inspection' or quality_approved"/><field name="rejection_reason" groups="!hair_purchase.hair_purchase_group_quality" readonly="1"/>
                    </group>
                        <field name="line_ids" groups="hair_purchase.hair_purchase_group_quality" readonly="state != 'inspection' or quality_approved">
                            <list editable="bottom" create="0" delete="0">
                                <field name="company_id" column_invisible="True"/>
                                <field name="hair_type_id" readonly="1"/><field name="length_id" readonly="1"/>
                                <field name="payable_weight"/><field name="proposed_grade_id"/><field name="grade_id"/>
                            </list>
                        </field>
                    </page><page string="Commercial" name="commercial"><group>
                        <field name="quoted_by_id"/><field name="quoted_date"/><field name="confirmed_by_id"/><field name="confirmed_date"/><field name="seller_name_snapshot"/>
                        <field name="cancellation_reason" groups="hair_supplier.hair_supplier_group_manager" readonly="state not in ('draft', 'inspection', 'confirmed')"/>
                        <field name="cancelled_by_id"/><field name="cancelled_date"/>
                    </group><field name="line_ids" readonly="1"><list>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="hair_type_snapshot"/><field name="grade_snapshot"/><field name="length_snapshot"/>
                        <field name="pricing_rule_id"/><field name="price_per_kg"/><field name="amount"/>
                    </list></field></page><page string="Notes" name="notes"><field name="notes"/></page></notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="hair_purchase_view_search" model="ir.ui.view">
        <field name="name">hair.purchase.search</field><field name="model">hair.purchase</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="seller_id"/><field name="buyer_id"/><filter name="purchase_date" string="Date" date="date"/><filter name="group_seller" string="Seller" context="{'group_by': 'seller_id'}"/><filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/></search></field>
    </record>
    <record id="hair_purchase_action" model="ir.actions.act_window">
        <field name="name">Hair Intakes</field><field name="res_model">hair.purchase</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="hair_purchase_menu" name="Hair Intakes" parent="hair_base.hair_base_menu_root" action="hair_purchase_action" sequence="5" groups="hair_supplier.hair_supplier_group_buyer,hair_purchase.hair_purchase_group_quality"/>
</odoo>
