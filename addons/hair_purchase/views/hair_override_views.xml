<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hair_price_override_wizard_form" model="ir.ui.view">
        <field name="name">hair.price.override.wizard.form</field>
        <field name="model">hair.price.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Override Price">
                <group><field name="line_id" readonly="1"/><field name="rate"/><field name="reason"/></group>
                <footer><button name="action_apply" type="object" string="Apply Override" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="hair_purchase_override_form" model="ir.ui.view">
        <field name="name">hair.purchase.override.form</field>
        <field name="model">hair.purchase</field>
        <field name="inherit_id" ref="hair_purchase_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='commercial']//field[@name='line_ids']/list" position="inside">
                <field name="override_base_rate" optional="hide"/>
                <field name="override_by_id" optional="hide"/>
                <field name="override_date" optional="hide"/>
                <field name="override_reason" optional="hide"/>
                <button name="action_open_price_override" type="object" string="Override Price" groups="hair_supplier.hair_supplier_group_manager" invisible="parent.state != 'inspection' or not parent.quoted_date"/>
            </xpath>
        </field>
    </record>
</odoo>
